---
interface Stop {
  name: string;
  lat: number;
  lng: number;
}
interface Props {
  stops: Stop[];
}
const { stops } = Astro.props;
const mapId = `map-${Math.random().toString(36).slice(2, 9)}`;
---

<div id={mapId} class="multi-map"></div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script define:vars={{ stops, mapId }}>
  function initMap() {
    const map = L.map(mapId);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 18,
    }).addTo(map);

    const latlngs = stops.map((s) => [s.lat, s.lng]);

    stops.forEach((s, i) => {
      L.marker([s.lat, s.lng])
        .addTo(map)
        .bindPopup(`${i + 1}. ${s.name}`);
    });

    if (latlngs.length > 1) {
      L.polyline(latlngs, { color: '#b5473f', weight: 3, dashArray: '6 6' }).addTo(map);
    }

    map.fitBounds(latlngs, { padding: [24, 24] });
  }

  if (window.L) {
    initMap();
  } else {
    window.addEventListener('load', initMap);
  }
</script>
